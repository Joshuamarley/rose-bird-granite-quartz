.wrap{padding-bottom:40rpx}
.tags{white-space:nowrap;padding:0 24rpx}
.tag{display:inline-block;margin-right:12rpx;padding:12rpx 22rpx;border:1rpx solid #e4ddd0;border-radius:999rpx;background:#fff;font-size:28rpx}
.tag.on{background:#1c1915;color:#fff}
.card{border-top:1rpx solid #e4ddd0;padding:20rpx 0}
.name{font-size:34rpx;font-weight:600;margin:4rpx 0}
.q{margin-top:16rpx;background:#fff;border:1rpx solid #e4ddd0;border-radius:16rpx;padding:16rpx 20rpx}
.hit{padding:22rpx 0;border-bottom:1rpx solid #e4ddd0;font-size:30rpx}
.pad{padding:0 24rpx 24rpx}
